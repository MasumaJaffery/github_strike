# GitHub Personal Access Token (optional but recommended for higher rate limits)
# Create one at: https://github.com/settings/tokens
# Required scopes: read:user, read:org (for organization stats)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server port (optional, defaults to 3000)
PORT=3000

# Flukebase.me Integration (optional)
# Get your API key at: https://flukebase.me/settings/api
FLUKEBASE_API_KEY=your_flukebase_api_key
FLUKEBASE_API_URL=https://api.flukebase.me
